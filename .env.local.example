# Copy to .env.local and fill in. Never commit .env.local.

# Which vendor serves every model call. Defaults to anthropic when unset.
LLM_PROVIDER=openai

# Server-side only. Neither key is ever sent to the browser.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...

# Optional. Pin different OpenAI models per tier; defaults are in lib/llm.ts and
# were chosen from what the key can actually reach:
#   node --env-file=.env.local scripts/models.mjs
OPENAI_MODEL_SMALL=
OPENAI_MODEL_STANDARD=
OPENAI_MODEL_LARGE=

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key: used only by scripts/seed.mjs and server routes. Never in the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Set to 1 to run every workflow against fixtures instead of the API: no key needed,
# no cost, and ai_usage still gets a row per call so metering stays on the path.
# MOCK_CLAUDE is the old name for this and is still honoured.
MOCK_LLM=

# Demo mode: signs every request in as this user until Google SSO is switched on.
DEMO_USER_EMAIL=dennysepiso@gmail.com

# Google Drive delivery for approved study packs and worksheets (lib/drive.ts).
# Leave MOCK_DRIVE=1 (or the credential empty) to fake uploads — a stable link, no
# network. To go live: a service-account key (raw JSON or base64) whose email the
# target Drive folders are shared with. Folders are mapped per subject/year in the
# drive_folder table (migration 0009); DRIVE_DEFAULT_FOLDER_ID is the fallback.
MOCK_DRIVE=1
GOOGLE_SERVICE_ACCOUNT_JSON=
DRIVE_DEFAULT_FOLDER_ID=

# Mail: each teacher connects their own Google mailbox (lib/mail/*).
# Leave MOCK_MAIL=1 (or the client id empty) to run against the fixture inbox in
# lib/mail/mocks.ts — the whole path works, nothing touches Google.
#
# To go live:
#   1. Google Cloud console -> APIs & Services -> Enable the Gmail API.
#   2. OAuth consent screen. Internal, if every teacher is on the school domain —
#      that skips Google's verification review entirely. External if not: at least
#      one address on the local staff list is a personal gmail.com, and an internal app cannot
#      reach it. gmail.modify and gmail.send are restricted scopes, so an External
#      app in production needs Google's verification (a CASA assessment) before
#      anyone outside the test-user list can connect. Adding the handful of staff as
#      test users works today and is capped at 100.
#   3. Credentials -> OAuth client ID -> Web application. Authorised redirect URI is
#      https://<your-host>/api/mail/callback (and http://localhost:3000/api/mail/callback).
#   4. MAIL_TOKEN_KEY: 32 random bytes, base64. Refresh tokens are encrypted with it.
#        node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#      Losing it costs every teacher a reconnect, nothing more.
MOCK_MAIL=1
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MAIL_TOKEN_KEY=
# Only needed when the callback host is not the host the app is served from.
GOOGLE_OAUTH_REDIRECT=
