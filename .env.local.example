# Copy to .env.local and fill in. Never commit .env.local.

# Which vendor serves every model call. Defaults to anthropic when unset.
LLM_PROVIDER=openai

# Server-side only. Neither key is ever sent to the browser.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...

# Optional. Pin different OpenAI models per tier; defaults are in lib/llm.ts and
# were chosen from what the key can actually reach:
#   node --env-file=.env.local scripts/models.mjs
OPENAI_MODEL_SMALL=
OPENAI_MODEL_STANDARD=
OPENAI_MODEL_LARGE=

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key: used only by scripts/seed.mjs and server routes. Never in the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Set to 1 to run every workflow against fixtures instead of the API: no key needed,
# no cost, and ai_usage still gets a row per call so metering stays on the path.
# MOCK_CLAUDE is the old name for this and is still honoured.
MOCK_LLM=

# One shared password in front of the whole site. Leave empty locally; REQUIRED on any
# deployment — v1 has no sign-in, so without it every visitor is the demo user.
SITE_PASSWORD=

# Demo mode: signs every request in as this user until Google SSO is switched on.
DEMO_USER_EMAIL=dennysepiso@gmail.com
